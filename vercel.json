{
  "rewrites": [
    { "source": "/", "destination": "/en" },
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/de/:path*", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/en", "permanent": true }
  ]
}
